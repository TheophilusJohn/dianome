{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "types": [
      "@webgpu/types"
    ],
    "paths": {
      "dianome-runtime": [
        "../runtime/dist/index.d.ts"
      ],
      "dianome-runtime/tokenizer": [
        "../runtime/dist/entries/tokenizer.d.ts"
      ],
      "dianome-runtime/planner": [
        "../runtime/dist/entries/planner.d.ts"
      ],
      "dianome-runtime/protocol": [
        "../runtime/dist/entries/protocol.d.ts"
      ],
      "dianome-runtime/session": [
        "../runtime/dist/entries/session.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
