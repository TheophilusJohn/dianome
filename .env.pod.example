# Phase 7 GPU day: copy to .env.pod (never committed; .gitignore has it), fill in, copy to the pod next to
# scripts/pod/setup.sh. Every scripts/pod/*.sh sources it. Plain KEY=value lines (no `export` needed).

HF_TOKEN=                      # Hugging Face read token (the Qwen repos are public; the token lifts the rate limit)
R2_ACCOUNT_ID=                 # same four as .env.r2 on the Mac: the pod uploads 3B/7B q8+q4 to R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dianome
SPLIT_SIGNING_KEY=             # the Worker's SPLIT_SIGNING_KEY secret: session tokens minted by api.dianome.dev must verify here
SPLIT_TOKEN=                   # bearer token for direct clients (the runtime gates, measure-remote.mjs); any long random string
CLOUDFLARED_TOKEN=             # token of the named tunnel whose public hostname gpu.dianome.dev -> http://localhost:8765 (WebSocket on)

# Optional (defaults shown)
# DIANOME_REPO=https://github.com/TheophilusJohn/dianome.git
# DIANOME_TAG=main             # tag or branch setup.sh checks out (the Phase 7 tag once it exists)
# DIANOME_DIR=/workspace/dianome
# HF_HOME=/workspace/hf        # model + dataset cache on the persistent volume
# GPU_BUDGET_HOURS=4           # run-all.sh stops adding optional work (7B probes) past this
# KEEP_ACTS=0                  # 1 keeps the probe activation stores (30-50 GB per model) after the linear probe
# FORCE_7B_PROBES=0            # 1 runs the 7B probes regardless of the budget rule
# SERVE_MODEL=qwen2.5-7b-instruct
# SERVE_PORT=8765
