{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dianome.dev/schemas/manifest.v1.json",
  "title": "Dianome manifest v1",
  "description": "Two-level manifest for a content-addressed chunk store. Physical layer: `chunks` (sha256 -> bytes). Logical layer: either `variants` (a safetensors model packed per layer group as fp16/q8/q4) or `files` (a directory of runtime-native files packed one stream per file). Every `bytes` field is a sum and must equal the sum of the listed chunks' lengths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "source", "chunk_size", "chunks"],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "description": "Artifact id; manifests live at manifests/<id>/latest.json and manifests/<id>/<sha256>.json" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "revision"],
      "properties": {
        "repo": { "type": "string", "minLength": 1, "description": "Hugging Face repo id, or a local:<name> marker for pack-dir on an unlabelled directory" },
        "revision": { "type": "string", "description": "Hugging Face commit sha, or empty when unknown" }
      }
    },
    "family": { "type": "string", "minLength": 1, "description": "config.model_type of the source, e.g. qwen2" },
    "config": { "$ref": "#/$defs/config" },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": { "files": { "type": "array", "items": { "$ref": "#/$defs/file" } } }
    },
    "runtime": { "enum": ["webllm", "transformersjs", "other"], "description": "Only for `files` manifests (generic packer)" },
    "chunk_size": { "const": 8388608 },
    "chunks": {
      "type": "object",
      "description": "Global physical table. Key = lowercase hex sha256 of the chunk bytes, stored at chunks/<sha256>.",
      "propertyNames": { "pattern": "^[0-9a-f]{64}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bytes"],
        "properties": { "bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 } }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fp16"],
      "properties": {
        "fp16": { "$ref": "#/$defs/variant" },
        "q8": { "$ref": "#/$defs/variant" },
        "q4": { "$ref": "#/$defs/variant" }
      }
    },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } }
  },
  "oneOf": [
    {
      "description": "Model manifest (pack-model)",
      "required": ["family", "config", "tokenizer", "variants"],
      "not": { "anyOf": [ { "required": ["files"] }, { "required": ["runtime"] } ] }
    },
    {
      "description": "Runtime-native files manifest (pack-dir)",
      "required": ["runtime", "files"],
      "not": { "anyOf": [ { "required": ["variants"] }, { "required": ["config"] }, { "required": ["tokenizer"] } ] }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "config": {
      "type": "object",
      "required": ["hidden_size", "num_hidden_layers", "num_attention_heads", "num_key_value_heads", "intermediate_size", "vocab_size", "rms_norm_eps", "rope_theta", "tie_word_embeddings", "max_position_embeddings"],
      "properties": {
        "hidden_size": { "type": "integer", "minimum": 1 },
        "num_hidden_layers": { "type": "integer", "minimum": 1 },
        "num_attention_heads": { "type": "integer", "minimum": 1 },
        "num_key_value_heads": { "type": "integer", "minimum": 1 },
        "intermediate_size": { "type": "integer", "minimum": 1 },
        "vocab_size": { "type": "integer", "minimum": 1 },
        "rms_norm_eps": { "type": "number", "exclusiveMinimum": 0 },
        "rope_theta": { "type": "number", "exclusiveMinimum": 0 },
        "tie_word_embeddings": { "type": "boolean" },
        "max_position_embeddings": { "type": "integer", "minimum": 1 }
      }
    },
    "segment": {
      "type": "object",
      "description": "Where a contiguous run of an entry's bytes lives inside one physical chunk",
      "additionalProperties": false,
      "required": ["chunk", "offset", "length"],
      "properties": {
        "chunk": { "$ref": "#/$defs/sha256" },
        "offset": { "type": "integer", "minimum": 0, "maximum": 8388607 },
        "length": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    },
    "part": {
      "type": "object",
      "description": "A sub-array of a quantized entry: offset relative to the entry start (256-byte aligned) and byte length",
      "additionalProperties": false,
      "required": ["offset", "length"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0, "multipleOf": 256 },
        "length": { "type": "integer", "minimum": 1 }
      }
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "fp16" } }
        },
        {
          "type": "object",
          "description": "Symmetric per-output-channel int8: int8 weights [out, in] row-major, then fp16 scale[out]",
          "additionalProperties": false,
          "required": ["kind", "parts"],
          "properties": {
            "kind": { "const": "q8" },
            "parts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["weights", "scales"],
              "properties": { "weights": { "$ref": "#/$defs/part" }, "scales": { "$ref": "#/$defs/part" } }
            }
          }
        },
        {
          "type": "object",
          "description": "Asymmetric group-wise 4-bit, group size 128 along `in`: nibble-packed weights [out, in/2] (even element in the low nibble), then fp16 scale[out, in/128], then uint8 zero[out, in/128]",
          "additionalProperties": false,
          "required": ["kind", "group_size", "parts"],
          "properties": {
            "kind": { "const": "q4" },
            "group_size": { "const": 128 },
            "parts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["weights", "scales", "zeros"],
              "properties": { "weights": { "$ref": "#/$defs/part" }, "scales": { "$ref": "#/$defs/part" }, "zeros": { "$ref": "#/$defs/part" } }
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "shape", "storage", "segments"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Original safetensors key (lm_head.weight when tied and absent from the file)" },
        "role": { "type": "string", "minLength": 1, "description": "Position-independent role, e.g. attn.q_proj.weight, mlp.gate_proj.weight, input_layernorm.weight" },
        "shape": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "storage": { "$ref": "#/$defs/storage" },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" }, "description": "Ordered; the client concatenates. Starts at a 256-byte-aligned offset of the group stream." },
        "tied": { "const": true, "description": "The entry has no bytes of its own; its segments point into the embed group" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "chunks", "entries"],
      "properties": {
        "name": { "type": "string", "pattern": "^(embed|layer\\.[0-9]+|final_norm|lm_head)$" },
        "bytes": { "type": "integer", "minimum": 0, "description": "Sum of the listed chunks' lengths (0 when tied)" },
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/sha256" }, "description": "Ordered; download order for the group. Chunk boundaries restart at every group stream." },
        "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } },
        "tied": { "const": true, "description": "lm_head with tie_word_embeddings: no chunks of its own" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "groups"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 0, "description": "Sum of group bytes" },
        "groups": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/group" }, "description": "Fixed order: embed, layer.0 .. layer.L-1, final_norm, lm_head" }
      }
    },
    "file": {
      "type": "object",
      "description": "A plain file stored as one stream (tokenizer files, or every file of a pack-dir artifact)",
      "additionalProperties": false,
      "required": ["name", "bytes", "chunks", "segments"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "File name, or path relative to the packed directory" },
        "bytes": { "type": "integer", "minimum": 0 },
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/sha256" } },
        "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } }
      }
    }
  }
}
