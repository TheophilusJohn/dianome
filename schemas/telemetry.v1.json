{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dianome.dev/schemas/telemetry.v1.json",
  "title": "Dianome load report v1",
  "description": "One model-load report posted by a client to POST /v1/telemetry/load. The Worker adds country, colo and a coarse timestamp from the request; it never stores the IP address or user agent string. Bodies over 4096 bytes are rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model", "variant", "bytes", "chunks", "ms", "source", "cache_hits", "browser", "webgpu"],
  "properties": {
    "schema": { "const": 1 },
    "model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128, "description": "Manifest id" },
    "variant": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$", "maxLength": 128, "description": "Variant name (fp16 | q8 | q4) or file path for a files manifest" },
    "bytes": { "type": "integer", "minimum": 0, "maximum": 1099511627776, "description": "Bytes received" },
    "chunks": { "type": "integer", "minimum": 0, "maximum": 1000000, "description": "Chunks fetched" },
    "ms": { "type": "integer", "minimum": 0, "maximum": 86400000, "description": "Wall time of the load" },
    "source": { "enum": ["network", "per-site-cache", "cross-site-cache", "mixed"] },
    "cache_hits": { "type": "integer", "minimum": 0, "maximum": 1000000, "description": "Chunks served from a cache; at most `chunks`" },
    "browser": { "enum": ["chrome", "firefox", "safari", "other"] },
    "webgpu": { "type": "boolean" }
  }
}
